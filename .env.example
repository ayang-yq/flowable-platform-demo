# Database Configuration
POSTGRES_PASSWORD=flowable123
# PostgreSQL runs on port 5433 (localhost:5433) to avoid conflicts with local PostgreSQL
# Docker Compose maps host port 5433 to container port 5432

# Backend Configuration
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx1024m

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NODE_ENV=production

# OAuth2 / Azure AD (Optional)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Mail Configuration for Notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@flowable-platform.com
