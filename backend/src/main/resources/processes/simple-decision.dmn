<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:flowable="http://flowable.org/dmn"
             id="simpleDecisionDefinitions"
             name="Simple Decision"
             namespace="http://flowable.org/dmn">

  <decision id="simpleDecision" name="Simple Decision">
    <decisionTable id="decisionTable" hitPolicy="FIRST">
      <input id="input1" label="Age">
        <inputExpression id="inputExpression1" typeRef="number">
          <text>age</text>
        </inputExpression>
      </input>
      <input id="input2" label="Income">
        <inputExpression id="inputExpression2" typeRef="number">
          <text>income</text>
        </inputExpression>
      </input>
      <output id="output1" label="Approval" name="approval" typeRef="boolean"/>

      <rule id="rule1">
        <inputEntry id="rule1-input1">
          <text>&gt;= 18</text>
        </inputEntry>
        <inputEntry id="rule1-input2">
          <text>&gt;= 50000</text>
        </inputEntry>
        <outputEntry id="rule1-output1">
          <text>true</text>
        </outputEntry>
      </rule>

      <rule id="rule2">
        <inputEntry id="rule2-input1">
          <text>&gt;= 18</text>
        </inputEntry>
        <inputEntry id="rule2-input2">
          <text>&lt; 50000</text>
        </inputEntry>
        <outputEntry id="rule2-output1">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>

</definitions>
