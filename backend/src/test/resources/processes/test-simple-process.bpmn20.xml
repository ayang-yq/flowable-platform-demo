<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/test">

    <process id="test-simple-process" name="Test Simple Process" isExecutable="true">

        <startEvent id="startEvent" name="Start"/>

        <userTask id="testUserTask" name="Test User Task">
            <documentation>Test task for integration testing</documentation>
        </userTask>

        <endEvent id="endEvent" name="End"/>

        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="testUserTask"/>
        <sequenceFlow id="flow2" sourceRef="testUserTask" targetRef="endEvent"/>

    </process>

</definitions>
